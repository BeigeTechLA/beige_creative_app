# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Secrets and environment variables
env/dev.json
env/prod.json

# iOS generated Google Maps key xcconfigs (written by Podfile from env/*.json)
ios/Flutter/GoogleMaps-dev.xcconfig
ios/Flutter/GoogleMaps-prod.xcconfig

# Local scratch / design references
/testing/

# Golden-test failure artifacts (diffs + masters re-emitted on every run)
/test/golden/failures/
